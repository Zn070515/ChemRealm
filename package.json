{
  "name": "chemrealm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "guards": "node tools/check_dependency_rules.mjs",
    "artifacts": "node tools/check_build_artifacts.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
