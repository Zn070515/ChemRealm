{
  "name": "chemrealm",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -p packages/schema/tsconfig.tests.json && tsc -p packages/sci/tsconfig.tests.json && tsc -p packages/world/tsconfig.tests.json && tsc -p packages/render/tsconfig.tests.json",
    "test": "vitest run",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "guards": "node tools/check_dependency_rules.mjs",
    "verify:scientific-math": "node tools/check_scientific_math.mjs",
    "verify:scientific-quantities": "node tools/check_scientific_quantity_boundary.mjs",
    "verify:m4-contracts": "node tools/check_m4_contract_consistency.mjs",
    "verify:m5-contracts": "node tools/check_m5_contract_consistency.mjs",
    "verify:world": "node tools/check_world_runtime_contract.mjs",
    "artifacts": "node tools/check_build_artifacts.mjs",
    "lint": "eslint .",
    "test:browser": "playwright test",
    "verify:guarantees": "tsc -p packages/schema/tsconfig.guarantees.json && tsc -p packages/sci/tsconfig.guarantees.json",
    "verify:schema-artifacts": "node packages/schema/scripts/emit-json-schema.mjs --check",
    "emit:schema": "node packages/schema/scripts/emit-json-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.1"
  }
}
