{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../schema" }]
}
