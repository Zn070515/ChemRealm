        "category": {
          "enum": [
            "measured",
            "evaluated",
            "calculated",
            "empirical",
            "pedagogicalApproximation"
          ],
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "modelVersion": {
          "minLength": 1,
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
