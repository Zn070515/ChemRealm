    "ionicStrengthMolal": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "mol/kg"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "ionicStrengthReduced": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "1"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "modelPh": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "1"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
