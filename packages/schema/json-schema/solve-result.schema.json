{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "state": {
          "additionalProperties": false,
          "properties": {
            "indicators": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "indicatorId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "protonationRatio": {
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "indicatorId",
                  "protonationRatio"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "ionicStrengthMolal": {
              "minimum": 0,
              "type": "number"
            },
            "ionicStrengthReduced": {
              "minimum": 0,
              "type": "number"
            },
            "modelPh": {
              "type": "number"
            },
            "provenance": {
              "additionalProperties": false,
              "properties": {
                "activityModel": {
                  "minLength": 1,
                  "type": "string"
                },
                "category": {
                  "enum": [
                    "measured",
                    "evaluated",
                    "calculated",
                    "empirical",
                    "pedagogicalApproximation"
                  ],
                  "type": "string"
                },
                "modelId": {
                  "minLength": 1,
                  "type": "string"
                },
                "modelVersion": {
                  "minLength": 1,
                  "type": "string"
                },
                "parameters": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "source": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                }
              },
              "required": [
                "modelId",
                "modelVersion",
                "activityModel",
                "category",
                "parameters"
              ],
              "type": "object"
            },
            "species": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "activity": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "activityCoefficient": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "amountMol": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "molality": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "reducedMolality": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "symbol": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "symbol",
                  "reducedMolality",
                  "molality",
                  "amountMol",
                  "activityCoefficient",
                  "activity"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "validity": {
              "additionalProperties": false,
              "properties": {
                "inDomain": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                },
                "withinProposedAccuracyEnvelope": {
                  "type": "boolean"
                }
              },
              "required": [
                "inDomain",
                "withinProposedAccuracyEnvelope"
              ],
              "type": "object"
            }
          },
          "required": [
            "species",
            "ionicStrengthMolal",
            "ionicStrengthReduced",
            "modelPh",
            "indicators",
            "validity",
            "provenance"
          ],
          "type": "object"
        },
        "status": {
          "const": "OK",
          "type": "string"
        }
      },
      "required": [
        "status",
        "state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "nearestSupported": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "validity": {
              "additionalProperties": false,
              "properties": {
                "ionicStrengthMolalMax": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "phase": {
                  "type": "string"
                },
                "solvent": {
                  "type": "string"
                },
                "species": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "temperatureKelvin": {
                  "additionalProperties": false,
                  "properties": {
                    "max": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "temperatureKelvin",
                "ionicStrengthMolalMax",
                "species",
                "solvent",
                "phase"
              ],
              "type": "object"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "description",
            "validity"
          ],
          "type": "object"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "MODEL_OUT_OF_DOMAIN",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "residual": {
          "type": "number"
        },
        "status": {
          "const": "NOT_CONVERGED",
          "type": "string"
        }
      },
      "required": [
        "status",
        "residual",
        "iterations"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "INVALID_INPUT",
          "type": "string"
        },
        "violations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "minLength": 1,
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "field",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "violations"
      ],
      "type": "object"
    }
  ]
}
