{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expression": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "enum": [
        "exact",
        "shortcut"
      ],
      "type": "string"
    },
    "modelId": {
      "minLength": 1,
      "type": "string"
    },
    "modelVersion": {
      "minLength": 1,
      "type": "string"
    },
    "omittedTerms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sourceStateHash": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "label",
    "expression",
    "omittedTerms",
    "modelId",
    "modelVersion",
    "sourceStateHash"
  ],
  "type": "object"
}
