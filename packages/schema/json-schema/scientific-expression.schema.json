{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "equationId": {
      "enum": [
        "charge-balance",
        "water-autoprotolysis",
        "acid-family-equilibrium",
        "acid-family-balance"
      ],
      "type": "string"
    },
    "expression": {
      "minLength": 1,
      "type": "string"
    },
    "formula": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "enum": [
        "exact",
        "shortcut"
      ],
      "type": "string"
    },
    "modelId": {
      "minLength": 1,
      "type": "string"
    },
    "modelVersion": {
      "minLength": 1,
      "type": "string"
    },
    "omittedTerms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "producerId": {
      "const": "scientific-core",
      "type": "string"
    },
    "producerVersion": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 3,
      "type": "number"
    },
    "sourceStateHash": {
      "minLength": 1,
      "type": "string"
    },
    "substitutions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "minLength": 1,
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "value",
          "unit"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "equationId",
    "label",
    "expression",
    "formula",
    "substitutions",
    "omittedTerms",
    "producerId",
    "producerVersion",
    "modelId",
    "modelVersion",
    "sourceStateHash"
  ],
  "type": "object"
}
